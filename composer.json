{
  "name": "vzgcoders/ai-router",
  "description": "ReactPHP local-first AI model router with Jev-driven routing and escalation.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "react/async": "^4.3",
    "react/child-process": "^0.6",
    "react/http": "^1.11",
    "react/promise-timer": "^1.11",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "VzgCoders\\AiRouter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VzgCoders\\AiRouter\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/ai-router"
  ],
  "scripts": {
    "lint": "php -l bin/ai-router && find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "php tests/run.php"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
