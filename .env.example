# Local-first policy
LOCAL_FIRST=true
CLOUD_CONFIDENCE_THRESHOLD=0.80
MAX_ATTEMPTS=3

# Ollama
OLLAMA_URL=http://192.168.0.188:11434/v1
OLLAMA_MODEL=gemma4-agent-32k
OLLAMA_NUM_CTX=32768
OLLAMA_TIMEOUT=120
OLLAMA_THINK=0

# Jev / TypeSafe
TYPESAFE_API_KEY=
JEV_URL=https://api.system-one.dev/v1
JEV_MODEL=jev
JEV_TIMEOUT=30

# Anthropic (optional; leave the key empty to route only local -> Copilot)
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TIMEOUT=120

# GitHub Copilot CLI
COPILOT_COMMAND=copilot
COPILOT_TIMEOUT=300

# HTTP server (OpenAI-compatible endpoint for Copilot Chat)
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8787
ROUTER_MODEL_ID=ai-router
ROUTER_API_KEY=

# Metrics
METRICS_FILE=var/metrics.jsonl